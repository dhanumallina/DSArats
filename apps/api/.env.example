# Server
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (dev: Neon free tier)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-random-secret"
JWT_REFRESH_SECRET="replace-with-random-secret"

# Access token TTL (string, e.g. 15m) and refresh lifetime in days
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS — the web app origin(s), comma-separated
CORS_ORIGIN=http://localhost:3000

# Email (Resend) — used from Phase 3 (verification / password reset)
# RESEND_API_KEY=
# EMAIL_FROM="DSARats <no-reply@dsarats.com>"