// DSARats — Prisma schema
// Phase 2: auth (User, Profile, Session)
// Phase 3: content (DSASheet, SheetTopic, Topic, Problem, SheetProblem, UserSheetProgress)
// Later phases add progress, streak, revision, notes, analytics entities.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String?
  googleId        String?       @unique
  role            UserRole      @default(USER)
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  profile       Profile?
  sessions      Session[]
  sheetProgress UserSheetProgress[]

  // Phase 4: progress, streak, daily challenge
  problems             UserProblem[]
  activities           ActivityLog[]
  streaks              StreakRecord[]
  dailyChallenges      DailyChallenge[]
  challengeCompletions DailyChallengeCompletion[]

  // Phase 5: spaced revision & notebook
  revisionSchedules RevisionSchedule[]
  notes             Note[]

  // Phase 6: gamification
  achievements UserAchievement[]

  // Phase 7: community
  createdGroups    StudyGroup[]    @relation("GroupCreator")
  groupMemberships GroupMember[]

  @@index([status])
}

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique
  username      String   @unique
  displayName   String?
  avatarUrl     String?
  bio           String?
  timezone      String   @default("UTC")
  theme         Theme    @default(SYSTEM)
  /** Phase 7: who may see this profile. Private until the learner opts in. */
  visibility    ProfileVisibility @default(PRIVATE)
  learningGoal  Int?
  longestStreak Int      @default(0)
  onboardedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── Phase 3: DSA content ─────────────────────────────────────────────────────

enum SheetDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum Platform {
  LEETCODE
  GEEKSFORGEEKS
  CODEFORCES
  OTHER
}

enum SheetProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model DSASheet {
  id                String           @id @default(uuid())
  slug              String           @unique
  name              String
  description       String
  difficulty        SheetDifficulty  @default(BEGINNER)
  estimatedHours    Int?
  isPublished       Boolean          @default(false)
  sourceAttribution String?
  order             Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  topics       SheetTopic[]
  problems     SheetProblem[]
  userProgress UserSheetProgress[]

  @@index([isPublished, order])
}

/** Ordered list of topics within a sheet (grouping + ordering of its problems). */
model SheetTopic {
  id       String   @id @default(uuid())
  sheetId  String
  topicId  String
  position Int      @default(0)
  createdAt DateTime @default(now())

  sheet DSASheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  topic Topic    @relation(fields: [topicId], references: [id])

  @@unique([sheetId, topicId])
  @@unique([sheetId, position])
}

model Topic {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  order       Int      @default(0)
  iconKey     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problems     Problem[]
  sheets       SheetTopic[]
  userProgress UserSheetProgress[]

  @@index([order])
}

model Problem {
  id                  String            @id @default(uuid())
  slug                String            @unique
  title               String
  difficulty          ProblemDifficulty @default(EASY)
  topicId             String
  pattern             String?
  platform            Platform          @default(LEETCODE)
  externalId          String?
  platformProblemUrl  String
  solutionUrl         String?
  tags                String[]          @default([])
  estimatedMinutes    Int?
  timeComplexityHint  String?
  spaceComplexityHint String?
  isPublished         Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  topic  Topic          @relation(fields: [topicId], references: [id])
  sheets SheetProblem[]

  // Phase 4: per-user progress and daily challenge rotation
  userProblems    UserProblem[]
  dailyChallenges DailyChallenge[]

  // Phase 5: spaced revision & notebook
  revisionSchedules RevisionSchedule[]
  notes             Note[]

  // Phase 7: weekly challenge membership
  weeklyChallenges WeeklyChallengeProblem[]

  @@unique([platform, externalId])
  @@index([topicId, difficulty])
  @@index([isPublished])
}

/** Ordered membership of a problem in a sheet. */
model SheetProblem {
  id        String  @id @default(uuid())
  sheetId   String
  problemId String
  position  Int
  isCore    Boolean @default(false)
  createdAt DateTime @default(now())

  sheet   DSASheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  problem Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([sheetId, problemId])
  @@unique([sheetId, position])
}

/** A user's progress on a sheet (started/continue/completed). */
model UserSheetProgress {
  id             String             @id @default(uuid())
  userId         String
  sheetId        String
  status         SheetProgressStatus @default(NOT_STARTED)
  currentTopicId String?
  startedAt      DateTime           @default(now())
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sheet DSASheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  topic Topic?   @relation(fields: [currentTopicId], references: [id])

  @@unique([userId, sheetId])
  @@index([userId, status])
}

// ── Phase 4: progress, streak & daily challenge ──────────────────────────────

enum ProblemStatus {
  NOT_STARTED
  ATTEMPTED
  SOLVED
  NEEDS_REVISION
  REVISED
  MASTERED
}

/** A user's status on a problem — the core tracking record. */
model UserProblem {
  id             String        @id @default(uuid())
  userId         String
  problemId      String
  status         ProblemStatus @default(NOT_STARTED)
  firstSolvedAt  DateTime?
  lastActivityAt DateTime?
  solveCount     Int           @default(0)
  /** The user's honest self-rating after the most recent revision (Phase 5). */
  difficultyAfterRevision RevisionDifficulty?
  lastRevisionAt          DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, status])
  @@index([userId, lastActivityAt])
}

/** Meaningful activity that can count toward a streak day (plan §4.3). */
enum ActivityType {
  PROBLEM_SOLVED
  PROBLEM_ATTEMPTED
  REVISION_COMPLETED
  DAILY_CHALLENGE
  NOTE_UPDATED
  LEARNING_SESSION
}

model ActivityLog {
  id         String       @id @default(uuid())
  userId     String
  type       ActivityType
  /** problemId / challengeId the activity refers to, when applicable. */
  refId      String?
  metadata   Json?
  occurredAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, type])
}

/** One row per (user, active day) — written idempotently so a day never double-counts. */
model StreakRecord {
  id             String   @id @default(uuid())
  userId         String
  activeDate     DateTime @db.Date
  activityTypes  String[]
  problemsSolved Int      @default(0)
  sessionsCount  Int      @default(0)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activeDate])
  @@index([userId, activeDate])
}

/** The problem chosen for one user's calendar day (in their own timezone). */
model DailyChallenge {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  problemId String
  /** Short, honest explanation of why this problem was chosen. */
  reason    String?
  /** Admin user id that scheduled it, when not auto-selected. */
  createdBy String?
  createdAt DateTime @default(now())

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     Problem                   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  completions DailyChallengeCompletion[]

  @@unique([userId, date])
  @@index([problemId])
}

enum DailyChallengeStatus {
  SOLVED
  ATTEMPTED
  SKIPPED
}

model DailyChallengeCompletion {
  id          String               @id @default(uuid())
  userId      String
  challengeId String
  status      DailyChallengeStatus
  completedAt DateTime             @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId, completedAt])
}

// ── Phase 5: spaced revision & notebook ──────────────────────────────────────

enum RevisionDifficulty {
  EASIER
  SAME
  HARDER
}

/**
 * Spaced-revision schedule for one (user, problem).
 *
 * `stage` indexes REVISION_INTERVALS_DAYS (1/3/7/14/30); each completed revision
 * advances it by one and pushes `dueAt` out, capping at the final interval.
 *
 * Mastering archives the row (`archivedAt` set) instead of deleting it, so completed
 * revisions stay visible in the user's history (plan §4.4). Active queues filter on
 * `archivedAt: null`; re-solving an archived problem restarts the cycle.
 */
model RevisionSchedule {
  id             String    @id @default(uuid())
  userId         String
  problemId      String
  stage          Int       @default(0)
  dueAt          DateTime
  lastReviewedAt DateTime?
  timesReviewed  Int       @default(0)
  /** Set when the problem is mastered; the row is kept for history. */
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, dueAt])
}

/**
 * The user's notebook entry for one problem.
 *
 * Every field is nullable and updated independently so the client can autosave one
 * field at a time without clobbering the rest.
 */
model Note {
  id              String   @id @default(uuid())
  userId          String
  problemId       String
  approach        String?
  mistakes        String?
  optimalApproach String?
  revisionNotes   String?
  keyPatterns     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

// ── Phase 6: gamification ────────────────────────────────────────────────────

/**
 * Which user statistic an achievement's criteria is measured against.
 *
 * Every metric is derived from the user's own rows, so an achievement can never be
 * awarded by hand or inferred from anything the user did not actually do.
 */
enum AchievementMetric {
  SOLVED
  MASTERED
  REVISIONS
  DAILY_CHALLENGES
  LONGEST_STREAK
  TOPICS_ENGAGED
  HARD_SOLVED
  SHEETS_COMPLETED
}

/**
 * Catalogue row for one achievement — the thing an unlock points at.
 *
 * Definitions live in `@dsarats/shared` and are synced here so unlocks can carry a
 * foreign key and admins can later manage copy without a code change.
 */
model Achievement {
  id          String            @id @default(uuid())
  key         String            @unique
  name        String
  description String
  iconKey     String
  metric      AchievementMetric
  threshold   Int
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  unlocks UserAchievement[]

  @@index([order])
}

/**
 * One unlock per (user, achievement).
 *
 * Evaluation runs on every meaningful activity and inserts with skipDuplicates, so
 * re-checking can never double-award. `unlockedAt` is the moment the criteria were
 * first observed as met — it is never backdated to a synthetic date.
 */
model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

// ── Phase 7: community & advanced ────────────────────────────────────────────

/**
 * Who may see a learner's profile.
 *
 * Private is the default, so nobody is exposed by merely signing up — publishing is an
 * explicit opt-in. The owner always sees their own profile either way.
 */
enum ProfileVisibility {
  PRIVATE
  PUBLIC
}

/** PUBLIC groups are listable and open to join; PRIVATE ones are invite-only. */
enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupRole {
  OWNER
  MEMBER
}

/** A study group learners can join. */
model StudyGroup {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String
  description String?
  visibility  GroupVisibility @default(PUBLIC)
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy User          @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members   GroupMember[]

  @@index([visibility, createdAt])
}

/** Membership of one learner in one group. At most one row per (group, user). */
model GroupMember {
  id       String    @id @default(uuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

/**
 * The shared problem set for one ISO week.
 *
 * The same set is shown to every learner so progress against it is comparable. It is
 * created lazily on the first read of a week and then kept, so it never re-rolls
 * mid-week and cannot be re-rolled by refreshing.
 */
model WeeklyChallenge {
  id          String   @id @default(uuid())
  /** ISO week key, e.g. 2026-W38. */
  weekKey     String   @unique
  title       String
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())

  problems WeeklyChallengeProblem[]

  @@index([weekKey])
}

model WeeklyChallengeProblem {
  id          String @id @default(uuid())
  challengeId String
  problemId   String
  position    Int

  challenge WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  problem   Problem         @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([challengeId, problemId])
  @@unique([challengeId, position])
}