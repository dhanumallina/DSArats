// DSARats — Prisma schema
// Phase 2: auth (User, Profile, Session)
// Phase 3: content (DSASheet, SheetTopic, Topic, Problem, SheetProblem, UserSheetProgress)
// Later phases add progress, streak, revision, notes, analytics entities.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String?
  googleId        String?       @unique
  role            UserRole      @default(USER)
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  profile       Profile?
  sessions      Session[]
  sheetProgress UserSheetProgress[]

  // Phase 4: progress, streak, daily challenge
  problems             UserProblem[]
  activities           ActivityLog[]
  streaks              StreakRecord[]
  challengeCompletions DailyChallengeCompletion[]

  @@index([status])
}

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique
  username      String   @unique
  displayName   String?
  avatarUrl     String?
  bio           String?
  timezone      String   @default("UTC")
  theme         Theme    @default(SYSTEM)
  learningGoal  Int?
  longestStreak Int      @default(0)
  onboardedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── Phase 3: DSA content ─────────────────────────────────────────────────────

enum SheetDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum Platform {
  LEETCODE
  GEEKSFORGEEKS
  CODEFORCES
  OTHER
}

enum SheetProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model DSASheet {
  id                String           @id @default(uuid())
  slug              String           @unique
  name              String
  description       String
  difficulty        SheetDifficulty  @default(BEGINNER)
  estimatedHours    Int?
  isPublished       Boolean          @default(false)
  sourceAttribution String?
  order             Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  topics       SheetTopic[]
  problems     SheetProblem[]
  userProgress UserSheetProgress[]

  @@index([isPublished, order])
}

/** Ordered list of topics within a sheet (grouping + ordering of its problems). */
model SheetTopic {
  id       String   @id @default(uuid())
  sheetId  String
  topicId  String
  position Int      @default(0)
  createdAt DateTime @default(now())

  sheet DSASheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  topic Topic    @relation(fields: [topicId], references: [id])

  @@unique([sheetId, topicId])
  @@unique([sheetId, position])
}

model Topic {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  order       Int      @default(0)
  iconKey     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problems     Problem[]
  sheets       SheetTopic[]
  userProgress UserSheetProgress[]

  @@index([order])
}

model Problem {
  id                  String            @id @default(uuid())
  slug                String            @unique
  title               String
  difficulty          ProblemDifficulty @default(EASY)
  topicId             String
  pattern             String?
  platform            Platform          @default(LEETCODE)
  externalId          String?
  platformProblemUrl  String
  solutionUrl         String?
  tags                String[]          @default([])
  estimatedMinutes    Int?
  timeComplexityHint  String?
  spaceComplexityHint String?
  isPublished         Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  topic  Topic          @relation(fields: [topicId], references: [id])
  sheets SheetProblem[]

  // Phase 4: per-user progress and daily challenge rotation
  userProblems    UserProblem[]
  dailyChallenges DailyChallenge[]

  @@unique([platform, externalId])
  @@index([topicId, difficulty])
  @@index([isPublished])
}

/** Ordered membership of a problem in a sheet. */
model SheetProblem {
  id        String  @id @default(uuid())
  sheetId   String
  problemId String
  position  Int
  isCore    Boolean @default(false)
  createdAt DateTime @default(now())

  sheet   DSASheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  problem Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([sheetId, problemId])
  @@unique([sheetId, position])
}

/** A user's progress on a sheet (started/continue/completed). */
model UserSheetProgress {
  id             String             @id @default(uuid())
  userId         String
  sheetId        String
  status         SheetProgressStatus @default(NOT_STARTED)
  currentTopicId String?
  startedAt      DateTime           @default(now())
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sheet DSASheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  topic Topic?   @relation(fields: [currentTopicId], references: [id])

  @@unique([userId, sheetId])
  @@index([userId, status])
}

// ── Phase 4: progress, streak & daily challenge ──────────────────────────────

enum ProblemStatus {
  NOT_STARTED
  ATTEMPTED
  SOLVED
  NEEDS_REVISION
  REVISED
  MASTERED
}

/** A user's status on a problem — the core tracking record. */
model UserProblem {
  id             String        @id @default(uuid())
  userId         String
  problemId      String
  status         ProblemStatus @default(NOT_STARTED)
  firstSolvedAt  DateTime?
  lastActivityAt DateTime?
  solveCount     Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, status])
  @@index([userId, lastActivityAt])
}

/** Meaningful activity that can count toward a streak day (plan §4.3). */
enum ActivityType {
  PROBLEM_SOLVED
  PROBLEM_ATTEMPTED
  REVISION_COMPLETED
  DAILY_CHALLENGE
  NOTE_UPDATED
  LEARNING_SESSION
}

model ActivityLog {
  id         String       @id @default(uuid())
  userId     String
  type       ActivityType
  /** problemId / challengeId the activity refers to, when applicable. */
  refId      String?
  metadata   Json?
  occurredAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, type])
}

/** One row per (user, active day) — written idempotently so a day never double-counts. */
model StreakRecord {
  id             String   @id @default(uuid())
  userId         String
  activeDate     DateTime @db.Date
  activityTypes  String[]
  problemsSolved Int      @default(0)
  sessionsCount  Int      @default(0)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activeDate])
  @@index([userId, activeDate])
}

/** The single problem chosen for a calendar day. */
model DailyChallenge {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  problemId String
  /** Short, honest explanation of why this problem was chosen. */
  reason    String?
  /** Admin user id that scheduled it, when not auto-selected. */
  createdBy String?
  createdAt DateTime @default(now())

  problem     Problem                   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  completions DailyChallengeCompletion[]

  @@unique([date])
  @@index([problemId])
}

enum DailyChallengeStatus {
  SOLVED
  ATTEMPTED
  SKIPPED
}

model DailyChallengeCompletion {
  id          String               @id @default(uuid())
  userId      String
  challengeId String
  status      DailyChallengeStatus
  completedAt DateTime             @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId, completedAt])
}